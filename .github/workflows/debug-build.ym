name: Debug Build

# Builds a debug APK of this branch and publishes it as a release asset,
# so it can be downloaded without signing secrets (the release workflow
# needs SIGNING_* secrets, which a fork does not have).
#
# The debug buildType targets the x86_64 emulator only (abiFilters), so the
# build step swaps it to arm64-v8a in the runner checkout (not committed)
# to produce an APK that installs on a real ARM64 phone. It installs as a
# separate ".debug" app next to the release build.

on:
  push:
    branches: [rtl-chat-messages]
    paths: [.github/workflows/debug-build.yml]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11' # Chaquopy buildPython requirement

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: ''

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build debug APK for ARM64 phones
        run: |
          sed -i 's/abiFilters += "x86_64"/abiFilters += "arm64-v8a"/' app/build.gradle.kts
          ./gradlew assembleDebug --no-daemon --stacktrace

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: Zafiro-debug-1.10.1-rtl
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error

      - name: Publish debug APK as a release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          cp app/build/outputs/apk/debug/app-debug.apk Zafiro-debug-1.10.1-rtl.apk
          ls -lh Zafiro-debug-1.10.1-rtl.apk
          gh release create "debug-rtl-${{ github.run_number }}" \
            Zafiro-debug-1.10.1-rtl.apk \
            --title "Debug build (RTL chat test) #${{ github.run_number }}" \
            --notes "Debug APK of the rtl-chat-messages branch (Persian/Arabic chat messages render right-to-left). Installs as a separate debug app alongside the release build."
